    # op shape: (26,26,32)\n    MaxPooling2D(pool_size=(2,2)),\n    # op shape: (13,13,32)\n\n    # Convolutional layer 2\n    Conv2D(filters=128, kernel_size=(3,3), activation='relu', padding='same'),\n    # op shape: (11,11,64)\n    MaxPooling2D(pool_size=(2,2)),\n    # op shape: (5,5,64)\n\n    # Flatten for Dense layers\n    Flatten(),\n    Dense(128, activation='relu'),\n    Dense(64, activation='relu'),\n    Dense(10, activation='softmax')  \n    ])\n\n    # compile model\n    model1.compile(optimizer='adam',\n              loss='sparse_categorical_crossentropy',\n              metrics=['accuracy'])\n\n    return model1\n    ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-18T07:38:20.291914Z","iopub.execute_input":"2025-12-18T07:38:20.292378Z","iopub.status.idle":"2025-12-18T07:38:20.297681Z","shell.execute_reply.started":"2025-12-18T07:38:20.292353Z","shell.execute_reply":"2025-12-18T07:38:20.296915Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Model training & CV Ensemble","metadata":{}},{"cell_type":"code","source":"test_preds = np.zeros((len(X_test), 10))        # To store averaged test predictions\noof_preds = np.zeros((len(X), 10))             # To store out-of-fold predictions for training set\n\nn_folds = 10\nskf = StratifiedKFold(n_splits=n_folds, shuffle=True, random_state=42)\n\nfor fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n    print(f\"\\nTraining fold {fold+1}/{n_folds}\")\n\n    # Split training and validation sets\n    X_train, X_val = X[train_idx], X[val_idx]\n    y_train, y_val = y[train_idx], y[val_idx]\n\n    # Build a fresh model for this fold\n    model = build_model()\n\n    # Train the model\n    history = model.fit(\n        X_train, y_train,\n        validation_data=(X_val, y_val),\n        epochs=40,\n        batch_size=128\n    )\n\n    # Fold validation accuracy (last epoch)\n    val_acc = history.history['val_accuracy'][-1]\n    print(f\"Fold {fold+1} validation accuracy: {val_acc:.4f}\")\n\n    # Predict on validation set and store in OOF array\n    val_fold_preds = model.predict(X_val, batch_size=128)\n    oof_preds[val_idx] = val_fold_preds\n\n    # Predict probabilities on test set and accumulate\n    test_fold_preds = model.predict(X_test, batch_size=128)\n    test_preds += test_fold_preds / n_folds   # Accumulate test predictions and average across folds\n\n# Compute overall OOF score\noof_pred_classes = np.argmax(oof_preds, axis=1)\noof_score = accuracy_score(y, oof_pred_classes)\n\nprint(f\"OOF Accuracy: {oof_score:.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-18T07:38:20.298476Z","iopub.execute_input":"2025-12-18T07:38:20.298786Z","iopub.status.idle":"2025-12-18T07:42:41.789765Z","shell.execute_reply.started":"2025-12-18T07:38:20.29877Z","shell.execute_reply":"2025-12-18T07:42:41.78873Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Submission","metadata":{}},{"cell_type":"code","source":"# Choose the class with the highest probability for each test sample\nfinal_test_labels = np.argmax(test_preds, axis=1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-18T07:42:41.790269Z","iopub.status.idle":"2025-12-18T07:42:41.790488Z","shell.execute_reply.started":"2025-12-18T07:42:41.790381Z","shell.execute_reply":"2025-12-18T07:42:41.790391Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Create a submission file\nsubmission = pd.DataFrame({\n    \"ImageId\": np.arange(1, len(final_test_labels) + 1),\n    \"Label\": final_test_labels\n})\nsubmission.to_csv(\"submission.csv\", index=False)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-18T07:42:41.791806Z","iopub.status.idle":"2025-12-18T07:42:41.792115Z","shell.execute_reply.started":"2025-12-18T07:42:41.791942Z","shell.execute_reply":"2025-12-18T07:42:41.791953Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"submission